# Core app
REACT_APP_GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
REACT_APP_PULSE_SERVER_URL=http://localhost:8080

# Pulse Web RUM (npm @dreamhorizonorg/pulse-web). Leave empty to skip SDK init.
# Use the same project API key as mobile / dev (e.g. default-project_devkey01).
REACT_APP_PULSE_WEB_API_KEY=default-project_devkey01
# AI Chat calls use this host with /v1/ai/* (proxy to pulse_ai). No separate AI base URL.
REACT_APP_ENABLE_AI_CHAT=false
NODE_ENV=development
REACT_APP_USE_MOCK_SERVER=false
REACT_APP_MOCK_DELAY=500
REACT_APP_MOCK_ERROR_RATE=0
REACT_APP_MOCK_LOGGING=false
REACT_APP_GCP_MULTI_TENANT_ENABLED=false
REACT_APP_FIREBASE_API_KEY=dummy
REACT_APP_FIREBASE_PROJECT_ID=dummy
REACT_APP_FIREBASE_APP_ID=dummy
REACT_APP_FIREBASE_AUTH_DOMAIN=dummy
REACT_APP_FIREBASE_AUTH_EMULATOR=false
REACT_APP_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
REACT_APP_GCP_TENANTS=dummy
REACT_APP_GCP_TENANT_LABELS=dummy
REACT_APP_AI_BASE_URL=http://localhost:8000
# Root Cause Analysis tab visibility. Must match backend ROOT_CAUSE_ENABLED
# (enable both when enabling the feature).
REACT_APP_ROOT_CAUSE_ENABLED=false
