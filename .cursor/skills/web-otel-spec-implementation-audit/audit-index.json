{
  "version": 1,
  "dimensions": [
    {
      "id": "spec_structure",
      "description": "SPEC has goal, assumptions, requirements, non-functional notes, and implementation file index."
    },
    {
      "id": "mermaid_hld",
      "description": "Mermaid diagram: high-level components, registry, boundaries (no sequence-level logic)."
    },
    {
      "id": "mermaid_ld",
      "description": "Mermaid diagram: internal modules, key types/functions, data flow between units."
    },
    {
      "id": "mermaid_flows_edge_cases",
      "description": "Mermaid flowchart or stateDiagram: happy path plus explicit branches for each documented edge (SSR, gates off, consent, uninstall, dedupe, etc.)."
    },
    {
      "id": "requirements_testable",
      "description": "Numbered requirements are concrete, testable statements."
    },
    {
      "id": "attribute_contract_table",
      "description": "Canonical attribute / span / log field tables aligned with semconv and code."
    },
    {
      "id": "implementation_paths",
      "description": "SPEC lists authoritative pulse-web-otel/src paths that exist in the repo."
    },
    {
      "id": "test_matrix_positive_negative_edge",
      "description": "Dedicated matrix: positive, negative, edge cases with given/when/then and test file or missing."
    },
    {
      "id": "spec_code_parity",
      "description": "SPEC behavior matches current implementation (default: update SPEC to follow code unless ADR says otherwise)."
    },
    {
      "id": "traceability_req_to_tests",
      "description": "Each requirement traces to at least one scenario or explicit gap."
    }
  ],
  "default_dimension_ids": [
    "spec_structure",
    "mermaid_hld",
    "mermaid_ld",
    "mermaid_flows_edge_cases",
    "requirements_testable",
    "attribute_contract_table",
    "implementation_paths",
    "test_matrix_positive_negative_edge",
    "spec_code_parity",
    "traceability_req_to_tests"
  ],
