ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  Pod::UI.puts "Configuring Pod with dynamically linked Frameworks".green
  use_frameworks!
end

target 'PulseReactNativeOtelExample' do
  config = use_native_modules!

  # Monorepo (and CI): sibling `pulse-ios-otel` next to `pulse-react-native-otel`. Otherwise CocoaPods
  # resolves PulseKit from PulseReactNativeOtel.podspec (published tag).
  pulsekit_sdk_root = File.expand_path('../../../pulse-ios-otel', __dir__)
  if File.exist?(File.join(pulsekit_sdk_root, 'PulseKit.podspec'))
    pod 'PulseKit', :path => pulsekit_sdk_root
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Apple Silicon simulators: drop legacy arm64 exclusion on pods (e.g. OpenTelemetry Swift) so swiftmodules match arm64 sim.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        key = 'EXCLUDED_ARCHS[sdk=iphonesimulator*]'
        val = cfg.build_settings[key]
        next if val.nil? || val == ''
        cfg.build_settings[key] = val.to_s.split(' ').reject { |a| a == 'arm64' }.join(' ')
      end
    end
  end
end
