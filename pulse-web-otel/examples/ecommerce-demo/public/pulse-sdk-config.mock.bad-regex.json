{
  "version": 103,
  "description": "Manual invalid-regex edge: condition.name is invalid RegExp (e.g. unclosed '['). safeRegex() falls back to literal — does not match normal log bodies / span names. Expect session.start, trackEvent, etc. still in OTLP; OTEL diag may warn. Do not use WHITELIST with only a broken rule (nothing matches list → all dropped by design). Path: VITE_PULSE_MOCK_SDK_CONFIG_PATH=/pulse-sdk-config.mock.bad-regex.json",
  "sampling": {
    "default": { "sessionSampleRate": 1 },
    "rules": [],
    "signalsToSample": [
      {
        "sampleRate": 0,
        "condition": {
          "name": "[unclosed-bracket-is-invalid-regex",
          "props": [],
          "scopes": ["logs", "traces"],
          "sdks": ["pulse_web_js"]
        }
      }
    ],
    "criticalSessionPolicies": { "alwaysSend": [] }
  },
  "signals": {
    "scheduleDurationMs": 5000,
    "attributesToDrop": [],
    "attributesToAdd": [],
