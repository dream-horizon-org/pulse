{
  "version": 100,
  "description": "ecommerce-demo mock — session rules, signalsToSample, BLACKLIST filters, attributes add/drop, metricsToAdd, critical alwaysSend. Toggle VITE_PULSE_MOCK_SDK_CONFIG=false to use your own pulse_sdk_config.",
  "sampling": {
    "default": { "sessionSampleRate": 0 },
    "rules": [
      {
        "name": "platform",
        "value": "web",
        "sdks": ["pulse_web_js"],
        "sessionSampleRate": 1
      },
      {
        "name": "device",
        "value": "^(desktop|mobile|tablet)$",
        "sdks": ["pulse_web_js"],
        "sessionSampleRate": 0.85
      }
    ],
    "signalsToSample": [
      {
        "sampleRate": 0,
        "condition": {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "session\\.end" }],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        }
      },
      {
        "sampleRate": 0,
        "condition": {
          "name": "^mock_signal_sample_blocked$",
          "props": [],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        }
      },
      {
        "sampleRate": 1,
        "condition": {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "non_fatal" }],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        }
      }
    ],
    "criticalEventPolicies": {
      "alwaysSend": [
        {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "device\\.crash" }],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        },
        {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "^sdk\\.init$" }],
          "scopes": ["logs", "traces"],
          "sdks": ["pulse_web_js"]
        }
      ]
    }
  },
  "signals": {
    "scheduleDurationMs": 5000,
    "attributesToDrop": [
      {
        "values": ["screen\\.name"],
        "condition": {
          "name": "^sdk\\.init$",
          "props": [],
          "scopes": ["logs", "traces"],
          "sdks": ["pulse_web_js"]
        }
      }
    ],
    "attributesToAdd": [
      {
        "values": [
          {
            "name": "pulse.demo.marker",
            "value": "mock-config-active",
            "type": "STRING"
          }
        ],
        "condition": {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "session\\.start" }],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        }
      }
    ],
    "filters": {
      "mode": "BLACKLIST",
      "values": [
        {
          "name": "^mock_filter_blocked$",
          "props": [],
          "scopes": ["logs"],
          "sdks": ["pulse_web_js"]
        }
      ]
    },
    "metricsToAdd": [
      {
        "name": "mock_demo_custom_event_total",
        "target": { "type": "name" },
        "condition": {
          "name": ".*",
          "props": [{ "key": "pulse\\.type", "value": "^custom_event$" }],
          "scopes": ["LOGS"],
          "sdks": ["pulse_web_js"]
        },
        "type": { "type": "counter" }
      }
    ]
  },
  "interaction": {
    "beforeInitQueueSize": 5000
  },
  "features": [
    {
      "featureName": "session",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "js_crash",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "custom_events",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "click",
      "sessionSampleRate": 0,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "network_instrumentation",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "web_vitals",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "screen_session",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "long_task",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "visibility",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "interaction",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "session_replay",
      "sessionSampleRate": 0,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "network_change",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "resource_timing",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "websocket",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    },
    {
      "featureName": "bfcache",
      "sessionSampleRate": 1,
      "sdks": ["pulse_web_js"],
      "config": null
    }
  ]
}
