{
  "version": 104,
  "description": "app_version rule: rule.value ^9\\. → sessionSampleRate 0 when service.version matches. Use VITE_PULSE_SERVICE_VERSION=9.0.0 vs 8.0.0; mock path session-app-version.json; clear localStorage pulse_sdk_config between runs.",
  "sampling": {
    "default": { "sessionSampleRate": 1 },
    "rules": [
      {
        "name": "app_version",
        "value": "^9\\.",
        "sdks": ["pulse_web_js"],
        "sessionSampleRate": 0
      }
    ],
    "signalsToSample": [],
    "criticalSessionPolicies": { "alwaysSend": [] }
  },
  "signals": {
    "scheduleDurationMs": 5000,
    "attributesToDrop": [],
    "attributesToAdd": [],
