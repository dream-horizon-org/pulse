[
  {
    "id": "checkout-happy",
    "name": "Checkout Happy Path",
    "events": [
      { "name": "checkout_step_1", "required": true },
      { "name": "checkout_step_2", "required": true },
      { "name": "checkout_step_3", "required": true }
    ],
    "thresholdInMs": 3000,
    "uptimeLowerLimitInMs": 700,
    "uptimeMidLimitInMs": 1400,
    "uptimeUpperLimitInMs": 2500,
    "globalBlacklistedEvents": ["ad_impression"]
  },
  {
    "id": "cart-open-to-checkout",
    "name": "Cart Open To Checkout Click",
    "events": [
      { "name": "cart_open", "required": true },
      {
        "name": "cart_checkout_click",
        "required": true,
        "props": [
          { "key": "item_count", "value": "0", "operator": "NOT_EQUALS" }
        ]
      }
    ],
    "thresholdInMs": 2500,
    "uptimeLowerLimitInMs": 500,
    "uptimeMidLimitInMs": 1000,
    "uptimeUpperLimitInMs": 1800,
    "globalBlacklistedEvents": ["device.crash"]
  },
  {
    "id": "product-quick-add",
    "name": "Product List Quick Add",
    "events": [
      {
        "name": "product_item_visible",
        "required": true,
        "props": [
          { "key": "source", "value": "product_list", "operator": "EQUALS" }
        ]
      },
      {
        "name": "add_to_cart",
        "required": true,
        "props": [
          { "key": "source", "value": "product_list", "operator": "EQUALS" }
        ]
      }
    ],
    "thresholdInMs": 2000,
    "uptimeLowerLimitInMs": 350,
    "uptimeMidLimitInMs": 900,
    "uptimeUpperLimitInMs": 1600,
    "globalBlacklistedEvents": ["error_demo_throw_uncaught"]
  },
  {
    "id": "product-detail-add",
    "name": "Product Detail Add To Cart",
    "events": [
      {
        "name": "product_detail_open",
        "required": true,
        "props": [
          { "key": "path", "value": "/products/", "operator": "STARTS_WITH" }
        ]
      },
      {
        "name": "add_to_cart",
        "required": true,
        "props": [
          { "key": "source", "value": "product_detail", "operator": "EQUALS" }
        ]
      }
    ],
    "thresholdInMs": 3500,
    "uptimeLowerLimitInMs": 800,
    "uptimeMidLimitInMs": 1500,
    "uptimeUpperLimitInMs": 2800,
    "globalBlacklistedEvents": ["ad_impression"]
  },
  {
    "id": "remove-item-sanity",
    "name": "Cart Remove Item Then Checkout",
    "events": [
      { "name": "cart_remove_item", "required": true },
      {
        "name": "cart_checkout_click",
        "required": true,
        "props": [
          { "key": "item_count", "value": "0", "operator": "NOT_EQUALS" }
        ]
      }
    ],
    "thresholdInMs": 2600,
    "uptimeLowerLimitInMs": 600,
    "uptimeMidLimitInMs": 1200,
    "uptimeUpperLimitInMs": 2100,
    "globalBlacklistedEvents": ["device.crash"]
  }
]
