# Test environment — loaded by Vite when running `--mode test`
# Used by Playwright E2E tests; OTLP calls go to a fake host intercepted by page.route()

# Use loopback so the browser can open a connection; Playwright routes still intercept /v1/* before the port is hit.
VITE_PULSE_ENDPOINT_BASE_URL=http://127.0.0.1:4318
VITE_PULSE_API_KEY=test-api-key
VITE_PULSE_SERVICE_NAME=ecommerce-demo-test

# Flush signals quickly so E2E assertions don't need to wait 5 seconds
VITE_PULSE_BATCH_DELAY_MS=5000

# Use JSON wire format so Playwright fixture can decode payloads (protobuf is the production default)
VITE_PULSE_FORMAT=json
# Disable gzip so Playwright receives plain JSON (optional — fixture handles gzip too)
VITE_PULSE_COMPRESSION=none
