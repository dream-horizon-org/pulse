# Endpoint is derived from apiKey in the SDK (dev keys → localhost:4318). This var is not read by `Pulse` / the SDK config object.
# VITE_PULSE_ENDPOINT_BASE_URL=https://ingest.pulse.io
VITE_PULSE_API_KEY=default-project_devkey01
VITE_PULSE_SERVICE_NAME=ecommerce-demo

# Optional; sets Pulse.init({ serviceVersion }) → OTEL service.version + app_version session rules (e.g. 9.0.0 vs 8.0.0 with session-app-version mock)
# VITE_PULSE_SERVICE_VERSION=9.0.0

# "true" → before React mounts, fetch public/pulse-sdk-config.mock.json into localStorage
# so SdkConfigFetcher.loadCached() matches Playwright seedPulseSdkConfig.
# Leave unset/false for normal remote /v1/configs/active behavior.
# VITE_PULSE_MOCK_SDK_CONFIG=true
# Optional path (default /pulse-sdk-config.mock.json). Other mocks: whitelist, bad-regex, session-app-version, session-fallback-default, critical-session-key, signal-normalization (see public/*.json descriptions)
# VITE_PULSE_MOCK_SDK_CONFIG_PATH=/pulse-sdk-config.mock.json
# Web Vitals manual QA — empty export filters + web_vitals gate on (see MANUAL-WEB-VITALS-DEMO.md):
# VITE_PULSE_MOCK_SDK_CONFIG_PATH=/pulse-sdk-config.mock.web-vitals.json

# Static Pulse.init instrumentations.webVitals (NOT in mock JSON — App.tsx reads env + URL):
# VITE_PULSE_WEB_VITALS_ENABLED=false skips the entire Web Vitals block (all six vitals). Omit for default (remote `web_vitals` gate + enabled).
# URL: ?pulse_wv_enabled=0

# "true" → before React mounts, fetch public/interaction-config.mock.json into localStorage
# so InteractionConfigFetcher.loadFromCache() starts with deterministic interaction flows.
# Leave unset/false for normal remote /v1/interaction-configs/ or /config/projects/* fetch behavior.
# VITE_PULSE_MOCK_INTERACTION_CONFIG=true
# Optional path (default /interaction-config.mock.json)
# VITE_PULSE_MOCK_INTERACTION_CONFIG_PATH=/interaction-config.mock.json

# "true" → Pulse.init({ logLevel: PulseLogLevel.DEBUG }) — SDK diagnostics + log-record lifecycle
# VITE_PULSE_DEBUG_LOG_LIFECYCLE=true

# Optional — IndexedDB failed-export buffer is ON by default (Android parity). Opt out:
# VITE_PULSE_DISK_BUFFER=false
# URL: ?pulse_disk=0
# Limits read inside @dreamhorizon/pulse-web when disk is on (same pattern as VITE_PULSE_BATCH_DELAY_MS):
# VITE_PULSE_DISK_BUFFER_MAX_AGE_MS=86400000
# VITE_PULSE_DISK_BUFFER_MAX_SIZE_BYTES=10485760

# Manual QA: shutdown, double-init, disk replay — examples/ecommerce-demo/MANUAL-PULSE-LIFECYCLE.md
