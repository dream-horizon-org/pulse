{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dreamhorizon/pulse-web": ["../../src/index.ts"],
      "@dreamhorizon/pulse-web/react": ["../../src/integrations/react/index.ts"]
    }
  },
  "include": ["src", "e2e"],
  "exclude": ["node_modules", "dist"]
}
