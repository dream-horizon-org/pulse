# Copy to .env.local (not committed) for local overrides.

VITE_PULSE_API_KEY=default-project_devkey01
VITE_PULSE_SERVICE_NAME=web-sdk-docs

# json = readable OTLP in DevTools; protobuf = default compact wire format
# VITE_PULSE_FORMAT=json

# Load public/pulse-sdk-config.mock.json into localStorage before Pulse.init
# (enables custom_events + other feature gates without hitting pulse-server)
VITE_PULSE_MOCK_SDK_CONFIG=true

# Optional log verbosity (verbose | debug | info | warn | error | none)
# VITE_PULSE_LOG_LEVEL=none

# Batch export interval (ms)
# VITE_PULSE_BATCH_DELAY_MS=5000
