{
  "name": "@dreamhorizonorg/pulse-web",
  "version": "0.1.0-alpha.1",
  "description": "Pulse observability SDK for web — OpenTelemetry-based RUM, sessions, errors, web vitals, network, and click instrumentation",
  "keywords": [
    "opentelemetry",
    "otel",
    "rum",
    "real-user-monitoring",
    "observability",
    "monitoring",
    "web-vitals",
    "error-tracking",
    "session-replay",
    "tracing",
    "react",
    "nextjs",
    "browser",
    "performance",
    "pulse"
  ],
  "homepage": "https://github.com/dream-horizon-org/pulse/tree/main/pulse-web-otel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-horizon-org/pulse.git",
    "directory": "pulse-web-otel"
  },
  "bugs": {
    "url": "https://github.com/dream-horizon-org/pulse/issues"
  },
  "author": "DreamHorizon (https://dreamhorizon.org)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./react/router": {
      "import": {
        "types": "./dist/react-router.d.ts",
        "default": "./dist/react-router.js"
      },
      "require": {
        "types": "./dist/react-router.d.cts",
        "default": "./dist/react-router.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./next-config": {
      "import": {
        "types": "./dist/next-config.d.ts",
        "default": "./dist/next-config.js"
      },
      "require": {
        "types": "./dist/next-config.d.cts",
        "default": "./dist/next-config.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "workspaces": [
    "examples/*"
  ],
  "packageManager": "yarn@4.3.1",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "size-limit": "size-limit",
    "publint": "publint",
    "attw": "attw --pack .",
    "prepack": "yarn build",
    "pack:tarball": "yarn build && npm pack",
    "demo": "yarn workspace ecommerce-demo dev",
    "demo:docs": "yarn workspace web-sdk-docs dev",
    "demo:build": "yarn build && yarn workspace ecommerce-demo build",
    "demo:docs:build": "yarn build && yarn workspace web-sdk-docs build",
    "demo:preview": "yarn demo:build && yarn workspace ecommerce-demo preview",
    "demo:install": "yarn install",
    "demo:test": "yarn workspace ecommerce-demo e2e:report",
    "e2e:web-sdk-gates": "yarn workspace ecommerce-demo e2e:web-sdk-gates",
    "demo:next": "yarn workspace nextjs-demo dev"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/instrumentation": "^0.217.0",
    "@opentelemetry/instrumentation-fetch": "^0.217.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.217.0",
    "@opentelemetry/otlp-exporter-base": "^0.217.0",
    "@opentelemetry/otlp-transformer": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "web-vitals": "^4.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "next": "^15.3.1",
    "publint": "^0.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "resolutions": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
