{
  "name": "@dreamhorizonorg/pulse-mcp",
  "version": "0.0.1-beta.1",
  "description": "MCP server for the Pulse mobile observability platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
  "pulse-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "typecheck": "tsc --noEmit",
    "promptfoo:eval": "yarn build && PROMPTFOO_DISABLE_TELEMETRY=1 && promptfoo eval -c evals/promptfoo/promptfooconfig.yaml",
    "promptfoo:eval:http": "yarn build && PROMPTFOO_DISABLE_TELEMETRY=1 && promptfoo eval -c evals/promptfoo/promptfooconfig-http.yaml",
    "promptfoo:view": "promptfoo view"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@google/adk": "^1.1.0",
    "@types/node": "^20.0.0",
    "promptfoo": "^0.121.11",
    "tsup": "^8.4.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "packageManager": "yarn@4.12.0+sha256.1fe4e1193cbcd13a48d8f436bb17d3c672b049a5e32a758aab9866a073db1702"
}
