<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.dreamhorizon</groupId>
  <artifactId>pulse-db-migrations</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>pulse-db-migrations</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <liquibase.version>4.29.0</liquibase.version>
    <liquibase.clickhouse.version>0.8.0</liquibase.clickhouse.version>
    <mysql.connector.version>8.0.33</mysql.connector.version>
    <clickhouse.jdbc.version>0.6.0</clickhouse.jdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
    </dependency>
    <dependency>
      <groupId>com.clickhouse</groupId>
      <artifactId>clickhouse-jdbc</artifactId>
      <version>${clickhouse.jdbc.version}</version>
      <classifier>http</classifier>
    </dependency>
    <dependency>
      <groupId>io.goodforgod</groupId>
      <artifactId>liquibase-clickhouse</artifactId>
      <version>${liquibase.clickhouse.version}</version>
    </dependency>
  </dependencies>

  <profiles>

    <profile>
      <id>mysql</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-maven-plugin</artifactId>
            <version>${liquibase.version}</version>
            <configuration>
              <changeLogFile>migrations/mysql/changelog-root.xml</changeLogFile>
              <url>${liquibase.mysql.url}</url>
              <username>${liquibase.mysql.username}</username>
              <password>${liquibase.mysql.password}</password>
              <driver>com.mysql.cj.jdbc.Driver</driver>
              <defaultSchemaName>${liquibase.mysql.schema}</defaultSchemaName>
              <promptOnNonLocalDatabase>false</promptOnNonLocalDatabase>
              <verbose>true</verbose>
              <lockWaitTimeInMinutes>2</lockWaitTimeInMinutes>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.connector.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>clickhouse</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-maven-plugin</artifactId>
            <version>${liquibase.version}</version>
            <configuration>
              <changeLogFile>migrations/clickhouse/changelog-root.xml</changeLogFile>
              <url>${liquibase.clickhouse.url}</url>
              <username>${liquibase.clickhouse.username}</username>
              <password>${liquibase.clickhouse.password}</password>
              <driver>com.clickhouse.jdbc.ClickHouseDriver</driver>
              <promptOnNonLocalDatabase>false</promptOnNonLocalDatabase>
              <verbose>true</verbose>
              <lockWaitTimeInMinutes>2</lockWaitTimeInMinutes>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>com.clickhouse</groupId>
                <artifactId>clickhouse-jdbc</artifactId>
                <version>${clickhouse.jdbc.version}</version>
                <classifier>http</classifier>
              </dependency>
              <dependency>
                <groupId>io.goodforgod</groupId>
                <artifactId>liquibase-clickhouse</artifactId>
                <version>${liquibase.clickhouse.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>
</project>
