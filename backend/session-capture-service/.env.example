# Copy to .env and adjust. Values here match config defaults where applicable.
# Existing environment variables are not overridden by .env (dotenvy).

# HTTP
# PORT=3400

# Optional HTTP limits (omit to use Axum/router defaults where applicable)
# REQUEST_TIMEOUT_SECONDS=
# BODY_CHUNK_READ_TIMEOUT_SECONDS=
# BODY_READ_CHUNK_SIZE_KB=256

# Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=session_recording_events
# KAFKA_PRODUCER_LINGER_MS=20
# KAFKA_PRODUCER_QUEUE_MIB=50
# KAFKA_MESSAGE_TIMEOUT_MS=20000
# KAFKA_PRODUCER_MESSAGE_MAX_BYTES=1000000
# KAFKA_COMPRESSION_CODEC=snappy
# KAFKA_PRODUCER_MAX_RETRIES=2
# KAFKA_PRODUCER_ACKS=all
# KAFKA_METADATA_MAX_AGE_MS=60000
# KAFKA_TOPIC_METADATA_REFRESH_INTERVAL_MS=20000
# KAFKA_SOCKET_TIMEOUT_MS=60000
# KAFKA_TLS=false
# KAFKA_CLIENT_ID=

# Logging (tracing_subscriber)
# RUST_LOG=pulse_session_capture=info
