<configuration scan="true" scanPeriod="1 seconds">
    <property scope="context" name="HOSTNAME" value="${HOSTNAME}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %date %highlight(%+5level) %-26thread %logger{36} %green(%msg) %n
            </pattern>
        </encoder>
    </appender>

    <logger name="org.dreamhorizon" level="warn"/>
    <logger name="io.netty" level="warn"/>
    <logger name="org.apache.parquet" level="warn"/>
    <logger name="org.apache.parquet.io" level="warn"/>
    <logger name="org.apache.hadoop" level="warn"/>
    <logger name="org.apache.avro" level="warn"/>
    <!-- Suppress AWS SDK polling noise — only errors/warnings -->
    <logger name="software.amazon.awssdk" level="WARN"/>
    <logger name="software.amazon.awssdk.request" level="WARN"/>

    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
