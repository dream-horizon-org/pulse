# Pulse Observability - Environment Variables Template
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ============================================
# MYSQL (docker-compose; same names as in compose)
# ============================================
MYSQL_ROOT_PASSWORD=pulse_root_password
MYSQL_DATABASE=pulse_db
MYSQL_USER=pulse_user
MYSQL_PASSWORD=pulse_password
MYSQL_WRITER_MAX_POOL_SIZE=10
MYSQL_READER_MAX_POOL_SIZE=10

# ============================================
# REDIS (external — e.g. pulse-kong stack; not bundled in this compose)
# Heatmap ingestion resolves redis://REDIS_HOST:REDIS_PORT when REDIS_URL is unset.
# Example when Kong Redis is on the host: REDIS_HOST=host.docker.internal
# ============================================
REDIS_HOST=
REDIS_PORT=6379

# ============================================
# FRONTEND CONFIGURATION (pulse-ui)
# ============================================
REACT_APP_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_DUMMY.apps.googleusercontent.com
REACT_APP_PULSE_SERVER_URL=http://localhost:8080
NODE_ENV=production
REACT_APP_USE_MOCK_SERVER=false
REACT_APP_MOCK_DELAY=500
REACT_APP_MOCK_ERROR_RATE=0
REACT_APP_MOCK_LOGGING=false
REACT_APP_GCP_MULTI_TENANT_ENABLED=true
REACT_APP_FIREBASE_API_KEY=DUMMY_FIREBASE_API_KEY
REACT_APP_FIREBASE_PROJECT_ID=dummy-project-id
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
REACT_APP_GCP_TENANTS=tenant1-xxxxx,tenant2-yyyyy
REACT_APP_GCP_TENANT_LABELS=tenant1-xxxxx:Tenant1,tenant2-yyyyy:Tenant2
REACT_APP_FIREBASE_AUTH_DOMAIN=dummy-project-id.firebaseapp.com
# Root Cause Analysis tab. Must match backend rollout: enable both when enabling
# the feature. When UI is built in deploy, set this so the tab visibility matches.
REACT_APP_ROOT_CAUSE_ENABLED=false

# ============================================
# LOGIN CONFIGURATION
# ============================================
GOOGLE_OAUTH_ENABLED=false

# Dev Mode API Key (only when GOOGLE_OAUTH_ENABLED=false)
# Stored as the API key for MySQL project_id "default-project" on startup. Use the pattern
# default-project_<suffix> (as below) so apps in local dev mode keep using local backends; if you
# override, keep the same pattern or dev clients may send traffic to the wrong environment.
DEV_MODE_API_KEY=default-project_devkey01
# ============================================

# S3 Configuration
S3_BUCKET_NAME=pulse-otel-config
SYMBOL_FILES_S3_BUCKET_NAME=-pulse-symbol-files
CONFIG_DETAILS_S3_FILE_PATH=config/pulse-config.json
INTERACTION_DETAILS_S3_FILE_PATH=config/interaction-config.json

# CloudFront Configuration (set to SKIP to skip invalidation during testing)
CLOUDFRONT_DISTRIBUTION_ID=SKIP
CONFIG_CLOUDFRONT_ASSET_PATH=/config/pulse-config.json
INTERACTION_CLOUDFRONT_ASSET_PATH=/config/interaction-config.json
# ============================================
# BACKEND CONFIGURATION (pulse-server)
# ============================================

# Default SES From when creating EMAIL notification channels (optional; server has built-in fallbacks).
DEFAULT_ALERT_EMAIL_FROM_ADDRESS=
DEFAULT_ALERT_EMAIL_FROM_NAME=

# Root Cause Analysis feature flag. When false, the root-cause API is disabled
# (returns 404 or route is not registered). Use ROOT_CAUSE_ENABLED consistently.
ROOT_CAUSE_ENABLED=false

# Application Environment (dev, stag, uat, prod)
# Required - validates config requirements based on environment
APP_ENVIRONMENT=dev

# OTEL collector / config URLs (returned to SDK clients; must be reachable from device/emulator)
# Local: use 10.0.2.2 (Android emulator → host). iOS simulator: localhost; physical device: host IP.
# Prod: set to your public collector/API URLs (e.g. https://collector.example.com:4318/...).


## For production
# INTERACTION_CONFIG_URL=http://pulse-server:8080/v1/interaction-configs/
# LOGS_COLLECTOR_URL=http://pulse-otel-collector/v1/logs
# METRIC_COLLECTOR_URL=http://pulse-otel-collector/v1/metrics
# SPAN_COLLECTOR_URL=http://pulse-otel-collector/v1/traces
# CUSTOM_EVENT_COLLECTOR_URL=http://pulse-otel-collector/v1/logs

INTERACTION_CONFIG_URL=http://10.0.2.2:8080/v1/interaction-configs/
LOGS_COLLECTOR_URL=http://10.0.2.2:4318/v1/logs
METRIC_COLLECTOR_URL=http://10.0.2.2:4318/v1/metrics
SPAN_COLLECTOR_URL=http://10.0.2.2:4318/v1/traces
CUSTOM_EVENT_COLLECTOR_URL=http://10.0.2.2:4318/v1/logs



# Application Configuration
CONFIG_SERVICE_APPLICATION_BQACCESSTOKENTTLSECONDS=600
CONFIG_SERVICE_APPLICATION_CLOUDRUNTOKENTTLSECONDS=600
CONFIG_SERVICE_APPLICATION_CONCORDBASEURL=https://concord.example.com
CONFIG_SERVICE_APPLICATION_CRONMANAGERBASEURL=http://pulse-alerts-cron:4000/cron
CONFIG_SERVICE_APPLICATION_DATAHIGHWAYBASEURL=https://data-highway-admin.example.com
CONFIG_SERVICE_APPLICATION_GCPDATAFLOWPROJECTURL=https://dataflow.googleapis.com/v1b3/projects/example-project
CONFIG_SERVICE_APPLICATION_GRAFANABASEURL=https://grafana.example.com
CONFIG_SERVICE_APPLICATION_GUARDIANBASEURL=https://guardian.example.com
CONFIG_SERVICE_APPLICATION_HODORBASEURL=https://hodor.example.com
CONFIG_SERVICE_APPLICATION_INTERACTIONDETAILCLOUDFRONTASSETPATH=/uat/InteractionDetails.json
CONFIG_SERVICE_APPLICATION_INTERACTIONDETAILSS3BUCKETFILEPATH=uat/InteractionDetails.json
CONFIG_SERVICE_APPLICATION_MSDBASEURL=https://msd.example.com
CONFIG_SERVICE_APPLICATION_PULSEAIBASEURL=https://pulse-agent-service.example.com
CONFIG_SERVICE_APPLICATION_PULSES3BUCKETNAME=pulse-ux-bucket-uat-dummy
CONFIG_SERVICE_APPLICATION_RBACIDSUFFIX=-uat
CONFIG_SERVICE_APPLICATION_SERVICEURL=http://pulse-server:8080
DASHBOARD_BASE_URL=http://localhost:3000
CONFIG_SERVICE_APPLICATION_SQLPOPULATEANOMALYBATCHSIZE=400
CONFIG_SERVICE_APPLICATION_SQLPOPULATEMETRICBATCHSIZE=750
CONFIG_SERVICE_APPLICATION_STREAMVERSEBASEURL=https://streamverse.example.com
CONFIG_SERVICE_APPLICATION_TOKENREFRESHTHREADPOOLSIZE=2
CONFIG_SERVICE_APPLICATION_TTLMILLISCONCORDEVENTS=300000
CONFIG_SERVICE_APPLICATION_USERAUTHURL=https://user-info.example.com/user
CONFIG_SERVICE_APPLICATION_USEREXPERIMENTATIONURL=https://experiment.example.com
CONFIG_SERVICE_APPLICATION_GOOGLEOAUTHCLIENTID=GOOGLE_OAUTH_CLIENT_ID_DUMMY.apps.googleusercontent.com
CONFIG_SERVICE_APPLICATION_JWTSECRET=change_me_dev_jwt_secret_at_least_32_chars
CONFIG_SERVICE_APPLICATION_GCP_PROJECT_ID=dummy
CONFIG_SERVICE_APPLICATION_GCP_DATASET=
CONFIG_SERVICE_APPLICATION_WEBHOOKURL=dummyWebHookUrl
CONFIG_SERVICE_APPLICATION_PULSESERVERURL=http://pulse-server:8080
CONFIG_SERVICE_APPLICATION_SERVICEJWTSECRET=dev_service_jwt_secret
CONFIG_REPLAY_API_BASE_URL=http://localhost:3400

# Vault Service Configuration (Secrets)
VAULT_SERVICE_DREAMAUTHAPIKEY=DUMMY_DREAMAUTH_API_KEY
VAULT_SERVICE_GRAPHANADASHBOARDTOKEN=DUMMY_GRAFANA_DASHBOARD_TOKEN
VAULT_SERVICE_INTERACTIONDETAILCLOUDFRONTDISTRIBUTIONID=DUMMY_CLOUDFRONT_DISTRIBUTION_ID
VAULT_SERVICE_SINKSTORECONFIGHOST=https://es.example.com:443
VAULT_SERVICE_SINKSTORECONFIGPASSWORD=DUMMY_SINKSTORE_PASSWORD
VAULT_SERVICE_SINKSTORECONFIGUSERNAME=DUMMY_SINKSTORE_USERNAME
VAULT_SERVICE_SINKTABLE=sample_table_uat
VAULT_SERVICE_SLACKAUTOBOTTOKEN=xoxb-DUMMY-SLACK-AUTO-BOT-TOKEN
VAULT_SERVICE_SLACKBOTAPPTOKEN=xapp-DUMMY-SLACK-BOT-APP-TOKEN
VAULT_SERVICE_SLACKBOTTOKEN=xoxb-DUMMY-SLACK-BOT-TOKEN
VAULT_SERVICE_SLACKENDPOINT=https://hooks.slack.com/services/DUMMY/PLACE/HOLDER
VAULT_SERVICE_STREAMVERSEAPITOKEN=DUMMY_STREAMVERSE_API_JWT_TOKEN
VAULT_ENCRYPTION_MASTER_KEY=abcdefghQ1Njc4abcdjM0NTY3ODkwMTIzNDU21234567=

# ============================================
# NOTIFICATION SERVICE CONFIGURATION
# ============================================
AWS_REGION=ap-south-1
NOTIFICATION_QUEUE_URL=
NOTIFICATION_DLQ_URL=
SES_CONFIGURATION_SET_NAME=
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INITIAL_DELAY_MS=1000
NOTIFICATION_RETRY_MAX_DELAY_MS=30000
NOTIFICATION_RETRY_MULTIPLIER=2.0
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_VISIBILITY_TIMEOUT=60
NOTIFICATION_WORKER_POLL_INTERVAL=1
NOTIFICATION_WORKER_ENABLED=true
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_UI_REDIRECT_URL=
SLACK_OAUTH_SCOPES=

# ============================================
# VECTOR (optional - custom events pipeline)
# ============================================
# Set to true to build and run Vector (S3/Athena custom events). Default: false.
VECTOR_ENABLED=false

# ============================================
# OTEL COLLECTOR CONFIGURATION
# ============================================
OTEL_CLICKHOUSE_DATABASE=otel
OTEL_CLICKHOUSE_USER=pulse_user
OTEL_CLICKHOUSE_PASSWORD=pulse_password

# ============================================
# CLICKHOUSE CLUSTER CONFIGURATION
# ============================================
# Required - ClickHouse cluster name for DDL replication across nodes
# Use empty string for single-node deployments (local dev)
CLICKHOUSE_CLUSTER_NAME=

# ============================================
# QUERY ENGINE CONFIGURATION
# ============================================
# Query engine selection: 'athena' (default) or 'gcp'
# Currenly only athena is supported
CONFIG_SERVICE_APPLICATION_QUERY_ENGINE=athena

# ATHENA CONFIGURATION
# ============================================
CONFIG_SERVICE_APPLICATION_ATHENA_REGION=ap-south-1
CONFIG_SERVICE_APPLICATION_ATHENA_DATABASE=pulse_athena_db
CONFIG_SERVICE_APPLICATION_ATHENA_OUTPUT_LOCATION=s3://puls-otel-config/

# AWS CREDENTIALS (for Athena)
# ============================================
AWS_ACCESS_KEY_ID=abc
AWS_SECRET_ACCESS_KEY=abc
AWS_SESSION_TOKEN=abc

# ============================================
# OPENFGA CONFIGURATION
# ============================================
OPENFGA_API_URL=http://openfga:8080
# Keep the following keys empty for local developement , but need to be poluated in
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_ENABLED=true

# ============================================
# MINIO / SESSION REPLAY S3 (dev)
# ============================================
MINIO_ROOT_USER=pulse_minio
MINIO_ROOT_PASSWORD=pulse_minio_secret
SESSION_REPLAY_S3_BUCKET=session-recordings
SESSION_REPLAY_S3_ENDPOINT=http://minio:9000
SESSION_REPLAY_S3_ACCESS_KEY_ID=pulse_minio
SESSION_REPLAY_S3_SECRET_ACCESS_KEY=pulse_minio_secret
SESSION_REPLAY_S3_REGION=us-south-1

# ============================================
# MINIO / HEATMAP S3 (dev)
# ============================================
# Heatmap screenshots — dedicated bucket (pulse-server + heatmap-screenshot-ingestion). Keys: heatmap-screenshots/...
HEATMAP_S3_BUCKET=heatmap-assets
HEATMAP_S3_ENDPOINT=http://minio:9000
# pulse-server only: presigned screenshot URLs use this host (browser). MinIO API on host is :9100 (:9000 on host is ClickHouse). Omit in AWS.
# HEATMAP_S3_PRESIGN_ENDPOINT=http://localhost:9100
HEATMAP_S3_ACCESS_KEY_ID=pulse_minio
HEATMAP_S3_SECRET_ACCESS_KEY=pulse_minio_secret
HEATMAP_S3_REGION=us-east-1
# HEATMAP_SCREENSHOTS_S3_PREFIX=heatmap-screenshots

# Heatmap screenshot ingestion reads HEATMAP_S3_* (see above); objects live under S3_PREFIX=heatmap-screenshots
# (set on the pulse-heatmap-screenshot-ingestion container / deploy scripts).
# Redis: start pulse-kong (or any Redis), then set REDIS_HOST/REDIS_PORT or REDIS_URL. With a resolved URL, HEATMAP_QUOTA_ENABLED defaults to true.
# REDIS_URL=redis://host.docker.internal:6379
# HEATMAP_QUOTA_ENABLED=true
# HEATMAP_QUOTA_PER_DAY=5
# HEATMAP_QUOTA_TTL_SECONDS=172800
# HEATMAP_DEDUPE_ENABLED=false
# HEATMAP_DEDUPE_TTL_SECONDS=172800

# ============================================
# PULSE AI (pulse-ai-agent starts with the stack)
# ============================================
# GOOGLE_API_KEY=   # set for Gemini; container runs without it but model calls fail
# PULSE_BASE_URL=http://pulse-server:8080   # default in compose for EM tools → pulse-server on pulse-network
# GOOGLE_GENAI_USE_VERTEXAI=0
# AGENT_MODEL=gemini-2.5-flash
# LOG_LEVEL=INFO
# # CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# SESSION_DB_URL: compose defaults to sqlite:////var/lib/pulse_ai/sessions.db on volume pulse-ai-sessions;
# override for another DB. Data survives container restart; docker compose down -v / removing the volume wipes it.
#
# pulse-server → pulse-ai-agent (in-container DNS):
AI_SERVICE_URL=http://pulse-ai-agent:8000
# Override when AI runs outside this compose project, e.g. http://host.docker.internal:8000

# ============================================
# SLACK CONFIGURATION
# ============================================
SLACK_CLIENT_ID=DUMMY_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=DUMMY_SLACK_CLIENT_SECRET
SLACK_OAUTH_SCOPES=chat:write,channels:read
SLACK_REDIRECT_URI=http://localhost:3000/integrations/slack/callback
SLACK_UI_REDIRECT_URL=http://localhost:3000/settings/integrations

# ============================================
# INCIDENT CONFIGURATION
# ============================================
INCIDENT_DEFAULT_SLACK_CHANNEL_ID=#test-incident-channel
