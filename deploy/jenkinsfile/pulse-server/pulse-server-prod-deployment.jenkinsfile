pipeline {
    agent {
        node { label 'ec2-pulse-deployment-fleet' }
    }

    options {
        ansiColor('xterm')
    }

    parameters {
        string(name: 'ARTIFACT_VERSION', description: 'Pulse Server artifact version to be deployed')
        string(name: 'PULSE_AI_VERSION', description: 'Pulse AI artifact version to be deployed')
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_VAR_artifact_version = "${params.ARTIFACT_VERSION}"
        DEPLOYMENT_SLACK_CHANNEL = credentials('DEPLOYMENT_SLACK_CHANNEL')
        TF_VAR_pulse_ai_artifact_version = "${params.PULSE_AI_VERSION}"
    }

    stages {
        stage('Clear Existing Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                        $class           : 'GitSCM',
                        branches         : [[name: '*/main']],
                        userRemoteConfigs: [[url: 'https://github.com/dream-horizon-org/pulse.git', credentialsId: 'd11-horizon-bot']]
                ])
            }
        }

        stage('Fetch Secrets') {
            steps {
                sh '''
                    cd deploy/terraform/pulse-server
                    echo "Fetching variables from AWS Secrets Manager..."
                    aws secretsmanager get-secret-value \
                      --region ap-south-1 \
                      --secret-id prod/pulseserver/terraform \
                      --query 'SecretString' \
                      --output text > secrets.auto.tfvars.json
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                    echo "Initializing Terraform..."
                    cd deploy/terraform/pulse-server
                    terraform init
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    echo "Running Terraform Plan..."
                    cd deploy/terraform/pulse-server
                    terraform plan -out=tfplan
                '''
            }
        }

        stage('Approval') {
            steps {
                input message: 'Review the Terraform Plan output above. Do you want to apply these changes to AWS?', ok: 'Yes, Deploy!'
            }
        }

        stage('Run DB Migrations') {
            steps {
                sh '''
                    echo "Fetching app env secrets for DB migration..."
                    APP_ENV_JSON=$(aws secretsmanager get-secret-value \
                        --region ap-south-1 \
                        --secret-id prod/pulseserver/appenv \
                        --query 'SecretString' \
                        --output text)

                    eval $(echo "$APP_ENV_JSON" | \
                        jq -r '.app_env[] | select(.key | test("^(MYSQL|CLICKHOUSE)")) | "export \(.key)=\(.value | @sh)"')

                    cd backend/db

                    MYSQL_URL="jdbc:mysql://${MYSQL_WRITER_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=true&requireSSL=true"
                    CH_URL="jdbc:clickhouse://${CLICKHOUSE_HOST}:${CLICKHOUSE_PORT}/otel"

                    echo "--- MySQL migrations ---"
                    mvn -B liquibase:update -Pmysql \
                        -Dliquibase.mysql.url="$MYSQL_URL" \
                        -Dliquibase.mysql.username="$MYSQL_USER" \
                        -Dliquibase.mysql.password="$MYSQL_PASSWORD" \
                        -Dliquibase.mysql.schema="$MYSQL_DATABASE"

                    echo "--- ClickHouse migrations ---"
                    mvn -B liquibase:update -Pclickhouse \
                        -Dliquibase.clickhouse.url="$CH_URL" \
                        -Dliquibase.clickhouse.username="$CLICKHOUSE_USERNAME" \
                        -Dliquibase.clickhouse.password="$CLICKHOUSE_PASSWORD"

                    echo "=== Migrations complete ==="
                '''
            }
        }

        stage('Terraform Apply') {
            steps {
                sh '''
                    echo "Applying Terraform changes..."
                    cd deploy/terraform/pulse-server
                    terraform apply -input=false tfplan
                '''
            }
        }

        stage('Wait for Instance Refresh') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    ASG_NAME=pulse-server-asg
                    REGION=ap-south-1
                    TIMEOUT=$((45 * 60))   # 45 min hard cap
                    SLEEP=20
                    ELAPSED=0
        
                    REFRESH_ID=$(aws autoscaling describe-instance-refreshes \
                        --auto-scaling-group-name "$ASG_NAME" \
                        --region "$REGION" \
                        --query 'InstanceRefreshes[0].InstanceRefreshId' \
                        --output text)
        
                    echo "Tracking instance refresh: $REFRESH_ID"
        
                    while true; do
                        STATUS=$(aws autoscaling describe-instance-refreshes \
                            --auto-scaling-group-name "$ASG_NAME" \
                            --region "$REGION" \
                            --instance-refresh-ids "$REFRESH_ID" \
                            --query 'InstanceRefreshes[0].Status' --output text)
                        PCT=$(aws autoscaling describe-instance-refreshes \
                            --auto-scaling-group-name "$ASG_NAME" \
                            --region "$REGION" \
                            --instance-refresh-ids "$REFRESH_ID" \
                            --query 'InstanceRefreshes[0].PercentageComplete' --output text)
        
                        echo "[$ELAPSED s] status=$STATUS pct=${PCT}%"
        
                        case "$STATUS" in
                            Successful)             echo "Refresh complete."; exit 0 ;;
                            Failed|Cancelled)       echo "Refresh $STATUS"; exit 1 ;;
                            Pending|InProgress|Cancelling) ;;
                            *) echo "Unknown status: $STATUS"; exit 1 ;;
                        esac
        
                        if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
                            echo "Timed out waiting for refresh."
                            exit 1
                        fi
                        sleep $SLEEP
                        ELAPSED=$((ELAPSED + SLEEP))
                    done
                '''
            }
        }
    }

    post {
        always {
            echo "Cleaning up workspace..."
            sh 'rm -f deploy/terraform/pulse-server/tfplan'
        }
        success {
            script {
                wrap([$class: 'BuildUser']) {
                    def message = "<!channel> Deployed to production by ${BUILD_USER_EMAIL}\n" +
                            "- Pulse Server: *${params.ARTIFACT_VERSION}*\n" +
                            "- Pulse AI: *${params.PULSE_AI_VERSION}*\n" +
                            "<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>"
                    def channel = "${env.DEPLOYMENT_SLACK_CHANNEL}"
                    slackSend(teamDomain: 'dreamsports.enterprise', channel: channel, color: 'good', message: message, tokenCredentialId: 'slack-creds', botUser: true)
                }
            }
        }
        failure {
            script {
                def message = "<!channel> Deployment failed\\n" +
                        "- Pulse Server: *${params.ARTIFACT_VERSION}*\n" +
                        "- Pulse AI: *${params.PULSE_AI_VERSION}*\n" +
                        "<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>"
                def channel = "${env.DEPLOYMENT_SLACK_CHANNEL}"
                slackSend(teamDomain: 'dreamsports.enterprise', channel: channel, color: 'danger', message: message, tokenCredentialId: 'slack-creds', botUser: true)
            }
        }
    }
}
