// kafka-replace-broker.jenkinsfile
//
// Replaces a failed broker with a new EC2 instance, re-attaching
// its existing EBS data volume (same node ID, data preserved).
//
// Jenkins job parameters:
//   NODE_ID      – which broker to replace (e.g. 2)
//   NUM_BROKERS  – total broker count (unchanged, e.g. 2)

pipeline {
    agent {
        node { label 'ec2-pulse-deployment-fleet' }
    }

    options {
        ansiColor('xterm')
    }

    parameters {
        string(name: 'NODE_ID', defaultValue: '', description: 'Node ID of the broker to replace (e.g. 2)')
    }

    environment {
        TF_IN_AUTOMATION         = 'true'
        ROUTE53_ZONE_NAME        = 'pulse.local'
        DEPLOYMENT_SLACK_CHANNEL = credentials('DEPLOYMENT_SLACK_CHANNEL')
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.NODE_ID) {
                        error("NODE_ID is required.")
                    }
                }
            }
        }

        stage('Clear Existing Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/feat/kafka-teraaform-scripts']],
                    userRemoteConfigs: [[url: 'https://github.com/dream-horizon-org/pulse.git', credentialsId: 'd11-horizon-bot']]
                ])
            }
        }

        stage('Fetch Secrets') {
            steps {
                sh '''
                    cd deploy/terraform/kafka
                    aws secretsmanager get-secret-value \
                      --region ap-south-1 \
                      --secret-id prod/kafka/terraform \
                      --query 'SecretString' \
                      --output text > secrets.auto.tfvars.json
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                sh """
                    NUM_BROKERS=\$(grep -c "node_id=" deploy/ansible/kafka/inventory/hosts.ini)
                    REPLACE_IDX=\$(( ${params.NODE_ID.toInteger()} - 1 ))

                    cd deploy/terraform/kafka
                    terraform init
                    terraform plan \
                        -replace="aws_instance.broker[\$REPLACE_IDX]" \
                        -var num_brokers=\$NUM_BROKERS \
                        -out=tfplan
                """
            }
        }

        stage('Approve') {
            steps {
                input message: "Replace broker ${params.NODE_ID} with a new EC2 instance? (EBS data volume preserved, node ID unchanged)", ok: 'Yes, Replace!'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh "cd deploy/terraform/kafka && terraform apply -input=false tfplan"
            }
        }

        stage('Wait for Instance Ready') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'pulse-prod-ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    sh """
                        TARGET_HOST="pulse-kafka-\$(printf '%02d' ${params.NODE_ID}).${ROUTE53_ZONE_NAME}"
                        echo "Waiting for \$TARGET_HOST to be SSH-reachable..."
                        for i in \$(seq 1 30); do
                            ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 \
                                -i "\$SSH_KEY" admin@\$TARGET_HOST echo ok 2>/dev/null && break
                            echo "Attempt \$i: not ready, retrying in 10s..."
                            sleep 10
                        done
                    """
                }
            }
        }

        stage('Fetch KRaft Cluster ID') {
            steps {
                sh '''
                    aws ssm get-parameter \
                        --region ap-south-1 \
                        --name "/pulse/kafka/production/kraft_cluster_id" \
                        --with-decryption \
                        --query 'Parameter.Value' \
                        --output text > /tmp/kraft_cluster_id.txt
                '''
            }
        }

        stage('Ansible: Configure Replacement Broker') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'pulse-prod-ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    sh """
                        KRAFT_CLUSTER_ID=\$(cat /tmp/kraft_cluster_id.txt)
                        TARGET_HOST="pulse-kafka-\$(printf '%02d' ${params.NODE_ID}).${ROUTE53_ZONE_NAME}"

                        NUM_BROKERS=\$(grep -c "node_id=" deploy/ansible/kafka/inventory/hosts.ini)

                        /home/admin/.local/bin/ansible-playbook deploy/ansible/kafka/replace-broker.yml \
                            -i deploy/ansible/kafka/inventory/hosts.ini \
                            --private-key "\$SSH_KEY" \
                            -e "target_host=\$TARGET_HOST" \
                            -e "node_id=${params.NODE_ID}" \
                            -e "kraft_cluster_id=\$KRAFT_CLUSTER_ID" \
                            -e "num_brokers=\$NUM_BROKERS" \
                            -e "route53_zone_name=${ROUTE53_ZONE_NAME}"
                    """
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f deploy/terraform/kafka/tfplan deploy/terraform/kafka/secrets.auto.tfvars.json /tmp/kraft_cluster_id.txt'
        }
//        success {
//            script {
//                wrap([$class: 'BuildUser']) {
//                    slackSend(teamDomain: 'dreamsports.enterprise', channel: env.DEPLOYMENT_SLACK_CHANNEL,
//                        color: 'good', tokenCredentialId: 'slack-creds', botUser: true,
//                        message: "<!channel> Kafka broker ${params.NODE_ID} replaced by ${BUILD_USER_EMAIL}\n<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>")
//                }
//            }
//        }
//        failure {
//            script {
//                slackSend(teamDomain: 'dreamsports.enterprise', channel: env.DEPLOYMENT_SLACK_CHANNEL,
//                    color: 'danger', tokenCredentialId: 'slack-creds', botUser: true,
//                    message: "<!channel> Kafka replace-broker FAILED (node ${params.NODE_ID})\n<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>")
//            }
//        }
    }
}
