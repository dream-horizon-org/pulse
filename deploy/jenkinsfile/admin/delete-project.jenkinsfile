pipeline {
    agent {
        node { label 'ec2-pulse-deployment-fleet' }
    }

    options {
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'PROJECT_ID',
            description: 'Project ID to permanently delete (e.g. proj-abc-123). All MySQL metadata, ClickHouse user, and OpenFGA tuples will be removed.'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Print what would be deleted without making any changes. Uncheck to execute.'
        )
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    def id = (params.PROJECT_ID ?: '').toString().trim()
                    if (!id || id == 'null') {
                        error 'PROJECT_ID is required and cannot be empty. Enter the project ID (e.g. proj-abc-123) and re-run.'
                    }
                }
            }
        }

        stage('Clear Existing Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/dream-horizon-org/pulse.git', credentialsId: 'd11-horizon-bot']]
                ])
            }
        }

        stage('Fetch Secrets') {
            steps {
                sh '''
                    set -e
                    set +x
                    echo "Fetching variables from AWS Secrets Manager..."
                    aws secretsmanager get-secret-value \
                        --region ap-south-1 \
                        --secret-id prod/pulseserver/appenv \
                        --query 'SecretString' \
                        --output text \
                        | jq -r '(reduce .app_env[] as $item ({}; . * {($item.key): $item.value})) as $e | "MYSQL_HOST=" + ($e.MYSQL_WRITER_HOST // ""), "MYSQL_PORT=" + ($e.MYSQL_PORT // "3306"), "MYSQL_USER=" + ($e.MYSQL_USER // ""), "MYSQL_PASSWORD=" + ($e.MYSQL_PASSWORD // ""), "MYSQL_DATABASE=" + ($e.MYSQL_DATABASE // "pulse_db"), "CH_ADMIN_HOST=" + ($e.CLICKHOUSE_HOST // ""), "CH_ADMIN_PORT=" + ($e.CLICKHOUSE_PORT // "8123"), "CH_ADMIN_USER=" + ($e.CLICKHOUSE_USERNAME // ""), "CH_ADMIN_PASSWORD=" + ($e.CLICKHOUSE_PASSWORD // ""), "CH_CLUSTER_NAME=" + ($e.CLICKHOUSE_CLUSTER_NAME // ""), "OPENFGA_API_URL=" + ($e.OPENFGA_API_URL // ""), "OPENFGA_STORE_ID=" + ($e.OPENFGA_STORE_ID // "")' > .db-ops-env
                '''
            }
        }

        stage('Preflight (Dry Run)') {
            environment {
                PROJECT_ID = "${params.PROJECT_ID}"
                DRY_RUN    = 'true'
            }
            steps {
                sh '''
                    set -e
                    set +x
                    set -a; . .db-ops-env; set +a
                    chmod +x deploy/jenkinsfile/admin/delete-project.sh
                    deploy/jenkinsfile/admin/delete-project.sh
                '''
            }
        }

        stage('Approval') {
            when {
                expression { return !params.DRY_RUN }
            }
            steps {
                input(
                    message: "Review the preflight output above.\n\nThis will PERMANENTLY delete project '${params.PROJECT_ID}' — MySQL rows, ClickHouse user, and OpenFGA tuples. This cannot be undone.\n\nProceed?",
                    ok: 'Yes, Delete!'
                )
            }
        }

        stage('Execute Deletion') {
            when {
                expression { return !params.DRY_RUN }
            }
            environment {
                PROJECT_ID = "${params.PROJECT_ID}"
                DRY_RUN    = 'false'
            }
            steps {
                sh '''
                    set -e
                    set +x
                    set -a; . .db-ops-env; set +a
                    deploy/jenkinsfile/admin/delete-project.sh
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -f .db-ops-env || true'
        }
    }
}
