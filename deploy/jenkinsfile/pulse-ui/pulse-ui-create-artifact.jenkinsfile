pipeline {
    agent {
        node { label 'ec2-fleet' }
    }

    stages {
        stage('Clear Existing Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Install Pre-requisites') {
            steps {
                script {
                    sh """
                        sudo apt-get install jq
                    """
                }
            }
        }

        stage('Clone repository') {
            steps {
                checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/feat/deployment']],
                        userRemoteConfigs: [[url: 'https://github.com/dream-horizon-org/pulse.git', credentialsId: 'd11-horizon-bot']]
                ])
            }
        }


        stage('Create Artifact') {
            steps {
                script {
                    sh '''
                        bash -lc '
                            set -e
                            source ~/.bashrc

                             # quick sanity checks
                            echo "PATH=$PATH"
                            which node && node -v
                            which yarn && yarn -v
                            chmod +x ./deploy/jenkinsfile/pulse-ui/create-artifact.sh
                            ./deploy/jenkinsfile/pulse-ui/create-artifact.sh
                        '
                    '''
                }
            }
        }
    }
}