pipeline {
    agent {
        node { label 'pulse-artifact-build-default-ec2-fleet' }
    }

    options {
        ansiColor('xterm')
    }

    environment {
        ARTIFACT_VERSION = ''
        GITBOT_USERNAME = credentials('github-bot-username')
        DEPLOYMENT_SLACK_CHANNEL = credentials('DEPLOYMENT_SLACK_CHANNEL')
    }

    stages {
        stage('Clear Existing Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Clone repository') {
            steps {
                checkout([
                        $class           : 'GitSCM',
                        branches         : [[name: '*/feat/session-replay-service-terraform']],
                        userRemoteConfigs: [[url: 'https://github.com/dream-horizon-org/pulse.git', credentialsId: 'd11-horizon-bot']]
                ])
            }
        }

        stage('Read Version') {
            steps {
                script {
                    ARTIFACT_VERSION = getVersionFromCargoToml()
                    echo "Version to be published: ${ARTIFACT_VERSION}"
                }
            }
        }

        stage('Publish Artifact') {
            steps {
                script {
                    sh """
                            #!/bin/bash -el
                            chmod +x ./deploy/jenkinsfile/session-capture/publish-artifact.sh
                            ./deploy/jenkinsfile/session-capture/publish-artifact.sh -v ${ARTIFACT_VERSION}
                        """
                }
            }
        }

        stage('Bump version for next development') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'yasir6jan', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                        def nextVersion = bumpSemverMinor(ARTIFACT_VERSION)
                        sh """
                            #!/bin/bash -el
                            CARGO="${WORKSPACE}/backend/session-capture-service/Cargo.toml"
                            sed -i.bak -E 's/^version = "[^"]+"/version = "${nextVersion}"/' "\$CARGO"
                            rm -f "\$CARGO.bak"

                            git config user.email "${GITBOT_USERNAME}@users.noreply.github.com"
                            git config user.name "${GITBOT_USERNAME}"

                            git add backend/session-capture-service/Cargo.toml
                            git commit -m "chore: bump pulse-session-capture version to ${nextVersion}"

                            git push https://${GIT_USER}:${GIT_TOKEN}@github.com/dream-horizon-org/pulse.git HEAD:main
                        """
                    }
                }
            }
        }
    }

    post {
        // success {
        //     script {
        //         def message = "<!channel> pulse-session-capture version *${ARTIFACT_VERSION}* published\n" +
        //                 "<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>"
        //         def channel = "${env.DEPLOYMENT_SLACK_CHANNEL}"
        //         slackSend(teamDomain: 'dreamsports.enterprise', channel: channel, color: 'good', message: message, tokenCredentialId: 'slack-creds', botUser: true)
        //     }
        // }
        // failure {
        //     script {
        //         def message = "<!channel> pulse-session-capture version *${ARTIFACT_VERSION}* publish failed\n" +
        //                 "<${env.BUILD_URL}|${env.JOB_NAME} ${env.BUILD_DISPLAY_NAME}>"
        //         def channel = "${env.DEPLOYMENT_SLACK_CHANNEL}"
        //         slackSend(teamDomain: 'dreamsports.enterprise', channel: channel, color: 'danger', message: message, tokenCredentialId: 'slack-creds', botUser: true)
        //     }
        // }
    }
}

def getVersionFromCargoToml(String path = 'backend/session-capture-service/Cargo.toml') {
    return sh(
            script: "grep -E '^version[[:space:]]*=' ${path} | head -1 | sed -E 's/^version[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\\1/'",
            returnStdout: true
    ).trim()
}

/** e.g. 0.1.0 -> 0.2.0 */
def bumpSemverMinor(String version) {
    def parts = version.tokenize('.')
    def major = parts[0] as int
    def minor = parts.size() > 1 ? parts[1] as int : 0
    return "${major}.${minor + 1}.0"
}
