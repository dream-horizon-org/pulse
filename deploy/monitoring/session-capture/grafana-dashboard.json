{
  "id": null,
  "uid": "pulse-session-capture-v1",
  "title": "Pulse — Session Capture Service",
  "description": "HTTP traffic, request latency, payload stats, and Kafka health for pulse-session-capture",
  "tags": ["pulse", "session-capture", "kafka"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": { "uid": "${datasource}" },
        "definition": "label_values(http_requests_total{service=\"pulse-session-capture\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(http_requests_total{service=\"pulse-session-capture\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate",
      "description": "Requests per second across selected instances",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(rate(http_requests_total{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "description": "Percentage of 5xx responses in the last 2m",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(rate(http_requests_total{service=\"pulse-session-capture\",instance=~\"$instance\",status=~\"5..\"}[2m])) / sum(rate(http_requests_total{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])) * 100",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(capture_active_connections{service=\"pulse-session-capture\",instance=~\"$instance\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events Captured/s",
      "description": "Recording events accepted per second",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(rate(capture_events_received_total{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Timeouts (5m)",
      "description": "Request timeouts in last 5 minutes",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(increase(middleware_request_timed_out_total{service=\"pulse-session-capture\",instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Kafka Producer Queue",
      "description": "Messages buffered in producer queue",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum(capture_kafka_producer_queue_depth{service=\"pulse-session-capture\",instance=~\"$instance\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "HTTP Traffic",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per Second (by HTTP Status)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "sum by (status) (rate(http_requests_total{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^2.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^4.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^5.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request Duration Percentiles",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_requests_duration_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "A",
          "legendFormat": "P50",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_requests_duration_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "B",
          "legendFormat": "P95",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_requests_duration_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "C",
          "legendFormat": "P99",
          "range": true
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Pipeline Latency",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pipeline Stage Latencies — P95",
      "description": "Time spent per stage: body read → decompress → JSON parse → e2e processing",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_body_read_time_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "A",
          "legendFormat": "body read",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_decompress_time_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "B",
          "legendFormat": "decompress",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_json_parse_time_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "C",
          "legendFormat": "json parse",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_processing_time_seconds_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "D",
          "legendFormat": "e2e processing",
          "range": true
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Payload Sizes",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Raw (Compressed) Payload Size Percentiles",
      "description": "Sizes of payloads as received from SDK before decompression",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(capture_raw_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "A",
          "legendFormat": "P50",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_raw_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "B",
          "legendFormat": "P95",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(capture_raw_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "C",
          "legendFormat": "P99",
          "range": true
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Full (Decompressed) Payload Size Percentiles",
      "description": "Sizes after decompression — what gets parsed and forwarded to Kafka",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(capture_full_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "A",
          "legendFormat": "P50",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(capture_full_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "B",
          "legendFormat": "P95",
          "range": true
        },
        {
          "datasource": { "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(capture_full_payload_size_bucket{service=\"pulse-session-capture\",instance=~\"$instance\"}[2m])))",
          "refId": "C",
          "legendFormat": "P99",
          "range": true
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
