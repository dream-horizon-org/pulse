# Set to 1 to use Vertex AI instead of Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=0

GOOGLE_API_KEY=google-api-key
AGENT_MODEL=gemini-2.5-flash

# ClickHouse (used by pulse_ai/scripts/build_event_catalog.py)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=otel

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated, defaults to localhost:3000,3001)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Session persistence (optional, defaults to in-memory)
# SQLite:     sqlite:///pulse_ai_sessions.db
# PostgreSQL: postgresql://user:pass@host:5432/pulse_ai
# When set, ADK sessions and the multi-tenant session scope sidecar share this URL.
# Use a real DB for durable project isolation across processes (in-memory scope is single-process only).
SESSION_DB_URL=